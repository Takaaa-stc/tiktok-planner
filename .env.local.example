# =============================================================================
# StudyPrint AI - 環境変数設定ファイル
# =============================================================================
# このファイルをコピーして .env.local という名前で保存し、各値を設定してください。
# cp .env.local.example .env.local
#
# ⚠️  .env.local は .gitignore に含まれており、Gitにコミットされません。
# ⚠️  本番環境では Vercel / Railway 等のダッシュボードで設定してください。
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# 取得場所: https://supabase.com/dashboard
#   → プロジェクトを選択 → Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL
#   "Project URL" の値（例: https://abcdefghijkl.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   "Project API keys" の "anon / public" の値
#   クライアントサイドのDB読み書きに使用（RLSポリシーが適用される）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SUPABASE_SERVICE_ROLE_KEY
#   "Project API keys" の "service_role / secret" の値
#   ⚠️  サーバーサイド専用。絶対にクライアントに露出させないこと。
#   Stripeウェブフック処理など、RLSをバイパスして操作する際に使用。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# 取得場所: https://platform.openai.com/api-keys
#   → "Create new secret key" で発行
#
# OPENAI_API_KEY
#   GPT-4o（画像認識対応）を使用します。
#   ⚠️  サーバーサイド専用。使用量に応じた従量課金が発生します。
#   料金目安: GPT-4o は入力 $2.50/1M tokens・出力 $10.00/1M tokens
OPENAI_API_KEY=sk-proj-...


# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# 取得場所: https://dashboard.stripe.com/apikeys
#   テスト環境では "Restricted keys" ではなく "Standard keys" の "Test" 用を使用。
#   本番公開時は "Live" 用のキーに切り替えること。
#
# STRIPE_SECRET_KEY
#   サーバーサイドのStripe API呼び出し（Checkoutセッション作成等）に使用。
#   テスト用は "sk_test_..." / 本番用は "sk_live_..." で始まる。
STRIPE_SECRET_KEY=sk_test_...

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#   クライアントサイドのStripe.js初期化に使用。
#   取得場所: Stripeダッシュボード → Developers → API keys → Publishable key
#   テスト用は "pk_test_..." / 本番用は "pk_live_..." で始まる。
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# STRIPE_WEBHOOK_SECRET
#   StripeからのWebhookを検証するための署名シークレット。
#   取得場所（ローカル開発）:
#     1. Stripe CLI をインストール: https://docs.stripe.com/stripe-cli
#     2. stripe listen --forward-to localhost:3000/api/stripe/webhook
#     3. 表示された "whsec_..." をコピーして設定
#   取得場所（本番）:
#     Stripeダッシュボード → Developers → Webhooks → エンドポイントを追加
#     → "Signing secret" の値
#   登録するイベント:
#     - checkout.session.completed
#     - customer.subscription.updated
#     - customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...


# -----------------------------------------------------------------------------
# Stripe 料金プラン ID
# -----------------------------------------------------------------------------
# 取得場所: https://dashboard.stripe.com/products
#   → 「商品を追加」→ 各プランの価格を作成後、
#     価格詳細ページの "price_..." で始まる Price ID をコピー。
#
# 作成手順:
#   1. Stripeダッシュボード → 商品カタログ → 「商品を追加」
#   2. 商品名「ライトプラン」/ 価格「¥980」/ 請求期間「月次」で作成
#   3. 商品名「プロプラン」/ 価格「¥1,980」/ 請求期間「月次」で作成
#   4. 各商品の Price ID（price_xxx）をそれぞれ設定
#
# ⚠️  テスト用と本番用で Price ID は異なります。
#      Stripeのテスト/本番モードを切り替えて別々に作成してください。

# ライトプラン (¥980/月)
STRIPE_LIGHT_PRICE_ID=price_...

# プロプラン (¥1,980/月)
STRIPE_PRO_PRICE_ID=price_...


# -----------------------------------------------------------------------------
# アプリケーション URL
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL
#   ローカル開発: http://localhost:3000
#   本番環境: https://your-domain.com（末尾スラッシュなし）
#   用途: Stripeのリダイレクト先URL・Supabase認証コールバックURLの生成
NEXT_PUBLIC_APP_URL=http://localhost:3000
